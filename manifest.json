
{
  "manifest_version": 3,
  "name": "AccessLayer",
  "version": "1.0.0",
  "description": "An adaptive accessibility assistant for websites.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "AccessLayer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "guide.js",
        "content.js"
      ],
      "css": [
        "guide.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
